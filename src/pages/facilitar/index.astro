---
import Base from '../../layouts/Base.astro';
import { RONDAS, CIERRE } from '../../content/seguridad';
import { dibujo } from '../../lib/art';
---
<Base title="Facilitar el juego" back={{ href: '/seguridad/', label: 'Seguridad digital' }}>
  <section class="contenedor fac">
    <!-- Acceso -->
    <div class="vista" data-vista="acceso" hidden>
      <div class="libro">
        <div class="hoja">
          <h1>Acceso para facilitar</h1>
          <p>Solo la persona facilitadora necesita cuenta. Los equipos entran con el código, sin datos personales.</p>
          <form id="login" class="form">
            <label>Correo<input type="email" name="email" required autocomplete="username" /></label>
            <label>Contraseña<input type="password" name="password" required autocomplete="current-password" /></label>
            <button class="btn btn-principal btn-grande" type="submit">Entrar</button>
            <p class="error" role="alert"></p>
          </form>
          <p class="pequeno">No hay registro público. La cuenta se crea en el panel de Supabase. Las presentaciones se abren desde el inicio sin iniciar sesión.</p>
        </div>
        <div class="hoja arte" set:html={dibujo('escena:bienvenida', 'Tortuga guía')} />
      </div>
    </div>

    <!-- Inicio del facilitador -->
    <div class="vista" data-vista="inicio" hidden>
      <h1>Juego «Pausa, piensa y pide ayuda»</h1>
      <div class="acciones">
        <button class="btn btn-principal btn-grande" data-a="crear">Crear sala</button>
        <a class="btn btn-grande" href="/seguridad/presentacion/#/9">Jugar sin internet</a>
        <button class="btn btn-texto" data-a="salir">Cerrar sesión</button>
      </div>
      <p class="error" role="alert"></p>
      <p class="aviso">Máximo 8 equipos por sala, un teléfono por equipo. La sala se cierra sola a las 4 horas y las respuestas se borran a los 7 días.</p>
    </div>

    <!-- Sala (pensada para proyectar) -->
    <div class="vista proy" data-vista="sala" hidden>
      <div class="estado-sala" data-e="lobby">
        <div class="lobby">
          <div>
            <p class="kicker">Entren en</p>
            <p class="url"></p>
            <p class="kicker">con el código</p>
            <p class="codigo" aria-live="polite"></p>
          </div>
          <div class="qr" aria-label="Código QR para entrar"></div>
        </div>
        <div class="conectados"><strong>Equipos conectados:</strong> <span class="lista-eq">—</span></div>
        <button class="btn btn-principal btn-grande" data-a="empezar">Empezar</button>
      </div>

      {RONDAS.map((r, i) => (
        <div class="estado-sala ronda" data-e={`q${i}`} hidden>
          <div class="libro">
            <div class="hoja escena">
              <div set:html={dibujo(r.escena, r.tema)} />
              <p class="burbuja-p"><small>{r.personaje} escribe:</small>«{r.mensaje}»</p>
            </div>
            <div class="hoja">
              <p class="kicker">Situación {i + 1} de {RONDAS.length} · {r.tema}</p>
              <div class="ops-p">
                {r.opciones.map((o, k) => (
                  <div class={`op-p ${o.cuidado ? 'cuidado' : ''}`}>
                    <span class="n">{k + 1}</span>
                    <span class="dib" set:html={dibujo(o.dibujo, o.texto)} />
                    <span class="t">{o.texto}</span>
                    <span class="barra-res"><span class="fill"></span><b class="cnt"></b></span>
                  </div>
                ))}
              </div>
              <p class="contador" aria-live="polite"></p>
              <div class="explica-p" hidden><strong>{r.frase}</strong> {r.explicacion}</div>
              <div class="acciones">
                <button class="btn btn-principal btn-grande" data-a="cerrar">Cerrar y ver</button>
                <button class="btn btn-principal btn-grande" data-a="siguiente" hidden>{i < RONDAS.length - 1 ? 'Siguiente situación' : 'Terminar'}</button>
              </div>
            </div>
          </div>
        </div>
      ))}

      <div class="estado-sala centro" data-e="fin" hidden>
        <h1>{CIERRE.titulo}</h1>
        <p class="resumen"></p>
        <p>{CIERRE.texto}</p>
        <p class="nota">{CIERRE.tarea}</p>
        <div class="acciones" style="justify-content:center">
          <button class="btn btn-principal" data-a="descargar">Descargar resumen para la bitácora</button>
          <button class="btn" data-a="nueva">Nueva sala</button>
        </div>
      </div>
      <p class="conexion" role="status" hidden></p>
    </div>

    <p class="sin-config aviso arcilla" hidden>Las salas con teléfonos todavía no están activadas en esta versión (faltan los datos de Supabase). Usá el juego en grupo: <a href="/seguridad/presentacion/#/9">abrir presentación</a>.</p>
  </section>
</Base>

<script>
  import QRCode from 'qrcode';
  import { sb, salasDisponibles, rpc, escucharSala, mensajeError, iconoEquipo, type EstadoSala } from '../../lib/sala';
  import { RONDAS } from '../../content/seguridad';

  const $ = <T extends HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<T>(s));
  const vista = (v: string) => $$<HTMLElement>('.vista').forEach((el) => (el.hidden = el.dataset.vista !== v));
  const KEY = 'pausa-sala-facilitador';
  let roomId: string | null = null;
  let estado: EstadoSala | null = null;
  let detener: (() => void) | null = null;

  async function arrancar() {
    if (!salasDisponibles) { $<HTMLElement>('.sin-config').hidden = false; return; }
    const { data } = await sb!.auth.getSession();
    const u = data.session?.user;
    if (!u || u.is_anonymous) return vista('acceso');
    try { roomId = sessionStorage.getItem(KEY); } catch {}
    if (roomId) abrirSala(); else vista('inicio');
  }

  $('#login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const err = $<HTMLElement>('.error', f);
    err.textContent = '';
    const { error } = await sb!.auth.signInWithPassword({ email: (f.elements.namedItem('email') as HTMLInputElement).value, password: (f.elements.namedItem('password') as HTMLInputElement).value });
    if (error) { err.textContent = /Invalid/i.test(error.message) ? 'Correo o contraseña incorrectos.' : mensajeError(error); return; }
    vista('inicio');
  });

  async function abrirSala() {
    vista('sala');
    const url = `${location.origin}/participar/`;
    $<HTMLElement>('.url').textContent = url.replace(/^https?:\/\//, '');
    $<HTMLElement>('.qr').innerHTML = await QRCode.toString(url, { type: 'svg', margin: 1, color: { dark: '#3C4035', light: '#FBF6E8' } });
    detener?.();
    detener = escucharSala(roomId!, pintar, (e) => { const c = $<HTMLElement>('.conexion'); c.hidden = false; c.textContent = 'Sin conexión con la sala: ' + mensajeError(e); });
  }

  function pintar(s: EstadoSala) {
    $<HTMLElement>('.conexion').hidden = true;
    estado = s;
    const clave = s.status === 'lobby' ? 'lobby' : s.status === 'ended' ? 'fin' : `q${s.q}`;
    $$<HTMLElement>('.estado-sala').forEach((el) => (el.hidden = el.dataset.e !== clave));
    if (s.code) $<HTMLElement>('.codigo').textContent = s.code.replace(/(\d{3})(\d{3})/, '$1 $2');
    $<HTMLElement>('.lista-eq').innerHTML = s.teams.length ? s.teams.map((t) => `<span class="chip">${iconoEquipo(t)} ${t}</span>`).join(' ') : 'Esperando equipos…';
    if (s.status === 'question' || s.status === 'reveal') {
      const p = $<HTMLElement>(`[data-e=q${s.q}]`);
      const cerrada = s.status === 'reveal';
      p.toggleAttribute('data-revelado', cerrada);
      $<HTMLElement>('.contador', p).textContent = cerrada ? '' : `${s.answered} de ${s.teams.length} equipos respondieron`;
      $<HTMLElement>('.explica-p', p).hidden = !cerrada;
      $<HTMLElement>('[data-a=cerrar]', p).hidden = cerrada;
      $<HTMLElement>('[data-a=siguiente]', p).hidden = !cerrada;
      const total = s.counts ? s.counts[0] + s.counts[1] : 0;
      $$<HTMLElement>('.op-p', p).forEach((op, k) => {
        const n = s.counts?.[k] ?? 0;
        $<HTMLElement>('.fill', op).style.width = cerrada && total ? `${(n / total) * 100}%` : '0';
        $<HTMLElement>('.cnt', op).textContent = cerrada ? `${n} ${n === 1 ? 'equipo' : 'equipos'}` : '';
      });
    }
    if (s.status === 'ended') pintarResumen();
  }

  async function pintarResumen() {
    try {
      const r = await rpc<{ teams: number; per_q: { q: number; opt0: number; opt1: number }[] }>('room_summary', { p_room: roomId });
      let mayoria = 0;
      for (const x of r.per_q) {
        const cuidado = RONDAS[x.q].opciones.findIndex((o) => o.cuidado);
        const c = cuidado === 0 ? x.opt0 : x.opt1, otra = cuidado === 0 ? x.opt1 : x.opt0;
        if (c > otra) mayoria++;
      }
      $<HTMLElement>('.resumen').textContent = `${r.teams} equipos. En ${mayoria} de ${RONDAS.length} situaciones la mayoría eligió cuidarse.`;
    } catch {}
  }

  async function set(status: string, q: number) {
    try { await rpc('set_state', { p_room: roomId, p_status: status, p_q: q }); }
    catch (e) { const c = $<HTMLElement>('.conexion'); c.hidden = false; c.textContent = mensajeError(e); }
  }

  document.addEventListener('click', async (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-a]')?.dataset.a;
    if (!a) return;
    if (a === 'crear') {
      try {
        const r = await rpc<{ room_id: string }>('create_room');
        roomId = r.room_id;
        try { sessionStorage.setItem(KEY, roomId); } catch {}
        abrirSala();
      } catch (err) { $<HTMLElement>('[data-vista=inicio] .error').textContent = mensajeError(err); }
    }
    if (a === 'salir') { await sb!.auth.signOut(); vista('acceso'); }
    if (a === 'empezar') set('question', 0);
    if (a === 'cerrar' && estado) set('reveal', estado.q);
    if (a === 'siguiente' && estado) estado.q < RONDAS.length - 1 ? set('question', estado.q + 1) : set('ended', estado.q);
    if (a === 'nueva') { detener?.(); try { sessionStorage.removeItem(KEY); } catch {} roomId = null; vista('inicio'); }
    if (a === 'descargar') {
      try {
        const r = await rpc<{ created_at: string; teams: number; per_q: { q: number; opt0: number; opt1: number }[] }>('room_summary', { p_room: roomId });
        const filas = ['situacion,tema,opcion_1,opcion_2,opcion_de_cuidado'];
        for (const x of r.per_q) filas.push(`${x.q + 1},${RONDAS[x.q].tema},${x.opt0},${x.opt1},${RONDAS[x.q].opciones.findIndex((o) => o.cuidado) + 1}`);
        const txt = `Resumen del juego «Pausa, piensa y pide ayuda»\nFecha: ${new Date(r.created_at).toLocaleString('es-CR')}\nEquipos: ${r.teams}\n\n${filas.join('\n')}\n\nSin datos personales: solo conteos por equipo.`;
        const url = URL.createObjectURL(new Blob([txt], { type: 'text/plain;charset=utf-8' }));
        Object.assign(document.createElement('a'), { href: url, download: `resumen-juego-${new Date().toISOString().slice(0, 10)}.txt` }).click();
        URL.revokeObjectURL(url);
      } catch (err) { alert(mensajeError(err)); }
    }
  });

  arrancar();
</script>

<style>
  .fac { padding-top: 1.6rem; }
  .vista[hidden], .estado-sala[hidden] { display: none; }
  .arte { background: var(--papel); display: grid; place-items: center; }
  .form { display: grid; gap: .9rem; max-width: 420px; }
  .form label { display: grid; gap: .3rem; font: 800 1rem/1 var(--f-control); }
  .form input { min-height: 52px; border: 2px solid var(--linea); border-radius: 12px; padding: 0 .9rem; font: 400 1.1rem var(--f-lectura); background: #fff; }
  .error { color: var(--arcilla); font: 700 1rem/1.3 var(--f-control); min-height: 1.3em; margin: 0; }
  .pequeno { font-size: .9rem; color: var(--tinta-suave); margin-top: 1rem; }
  .acciones { display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; margin: 1rem 0; }
  .kicker { font: 800 .9rem/1 var(--f-control); letter-spacing: .07em; text-transform: uppercase; color: var(--bosque); margin: 0 0 .4rem; }
  .lobby { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; background: var(--pagina); border-radius: var(--r-grande); padding: 2rem 2.4rem; box-shadow: var(--sombra); }
  .url { font: 800 clamp(1.4rem, 3vw, 2.2rem)/1.1 var(--f-control); margin: 0 0 1.4rem; word-break: break-all; }
  .codigo { font: 400 clamp(4rem, 10vw, 7.5rem)/1 var(--f-cuento); letter-spacing: .06em; margin: 0; color: var(--arcilla); }
  .qr { background: var(--pagina); border: 3px solid var(--tinta); border-radius: 18px; padding: .6rem; max-width: 320px; justify-self: center; width: 100%; }
  .conectados { margin: 1.2rem 0; font-size: 1.15rem; }
  .conectados :global(.chip) { display: inline-block; background: var(--miel-claro); border-radius: 999px; padding: .35rem .8rem; margin: .2rem; font: 800 1.05rem/1 var(--f-control); }
  .ronda .libro { min-height: 70vh; }
  .escena { background: var(--papel); display: grid; align-content: center; gap: 1rem; }
  .burbuja-p { background: #fff; border: 3px solid var(--tinta); border-radius: 20px 20px 20px 4px; padding: 1rem 1.2rem; font: 700 1.4rem/1.35 var(--f-control); margin: 0; }
  .burbuja-p small { display: block; font-size: .9rem; color: var(--arcilla); margin-bottom: .3rem; }
  .ops-p { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0; }
  .op-p { position: relative; border: 3px solid var(--tinta); border-radius: 18px; background: #fff; padding: .8rem; display: grid; gap: .4rem; justify-items: center; text-align: center; font: 800 1.2rem/1.2 var(--f-control); }
  .op-p .dib :global(svg) { max-height: 140px; }
  .op-p .n { position: absolute; top: -14px; left: -12px; width: 42px; height: 42px; border-radius: 50%; background: var(--miel); border: 3px solid var(--tinta); display: grid; place-items: center; }
  .barra-res { width: 100%; height: 30px; background: var(--papel); border-radius: 999px; position: relative; overflow: hidden; display: none; }
  .barra-res .fill { position: absolute; inset: 0 auto 0 0; background: var(--miel); transition: width .5s ease; }
  .barra-res b { position: relative; font: 800 .95rem/30px var(--f-control); }
  [data-revelado] .barra-res { display: block; }
  [data-revelado] .op-p.cuidado { background: var(--bosque-claro); border-color: var(--bosque); }
  [data-revelado] .op-p.cuidado .fill { background: var(--bosque); }
  [data-revelado] .op-p.cuidado b { color: #fff; }
  [data-revelado] .op-p:not(.cuidado) { opacity: .6; }
  .contador { font: 800 1.3rem/1 var(--f-control); color: var(--bosque); }
  .explica-p { background: var(--bosque-claro); border-left: 6px solid var(--bosque); border-radius: 12px; padding: .9rem 1.1rem; font-size: 1.15rem; }
  .explica-p strong { font: 400 1.4rem/1.2 var(--f-cuento); color: var(--bosque); display: block; }
  .centro { text-align: center; padding: 3rem 0; }
  .resumen { font: 800 1.4rem/1.3 var(--f-control); color: var(--bosque); }
  .conexion { background: var(--miel-claro); border-radius: 12px; padding: .7rem 1rem; font-weight: 700; }
  @media (max-width: 860px) { .lobby { grid-template-columns: 1fr; } }
</style>
