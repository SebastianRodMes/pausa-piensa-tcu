---
import Base from '../../layouts/Base.astro';
import { RONDAS } from '../../content/seguridad';
import { dibujo } from '../../lib/art';
import { EQUIPOS } from '../../lib/sala';
---
<Base title="Unirme a un juego" back={{ href: '/', label: 'Inicio' }}>
  <section class="contenedor movil">
    <!-- 1. Código -->
    <div class="paso" data-paso="codigo">
      <h1>Escriban el código que ven en la pantalla</h1>
      <div class="casillas" aria-live="polite" aria-label="Código"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="teclado" role="group" aria-label="Teclado numérico">
        {[1,2,3,4,5,6,7,8,9].map((n) => <button type="button" data-n={n}>{n}</button>)}
        <button type="button" data-borrar aria-label="Borrar">⌫</button>
        <button type="button" data-n="0">0</button>
        <button type="button" class="entrar" data-entrar disabled>Entrar</button>
      </div>
      <p class="error" role="alert"></p>
      <p class="pista">No necesitan nombre, correo ni contraseña. Una persona adulta puede ayudar a escribir.</p>
    </div>

    <!-- 2. Equipo -->
    <div class="paso" data-paso="equipo" hidden>
      <h1>Elijan el nombre del equipo</h1>
      <div class="equipos">
        {EQUIPOS.map((e) => <button type="button" class="eq" data-eq={e.nombre} style={`--c:${e.color}`}><span>{e.icono}</span>{e.nombre}</button>)}
      </div>
      <p class="error" role="alert"></p>
    </div>

    <!-- 3. Espera -->
    <div class="paso centro" data-paso="espera" hidden>
      <div class="mi-equipo"></div>
      <h1>¡Listo! Miren el proyector</h1>
      <p class="nota">La pregunta aparece pronto.</p>
    </div>

    <!-- 4. Pregunta -->
    {RONDAS.map((r, i) => (
      <div class="paso" data-paso={`q${i}`} hidden>
        <p class="kicker">Situación {i + 1} de {RONDAS.length} · {r.tema}</p>
        <p class="burbuja-m">«{r.mensaje}»</p>
        <div class="ops">
          {r.opciones.map((o, k) => (
            <button type="button" class="op" data-q={i} data-op={k} aria-pressed="false">
              <span class="n">{k + 1}</span>
              <span set:html={dibujo(o.dibujo, o.texto)} />
              <span class="t">{o.texto}</span>
            </button>
          ))}
        </div>
        <p class="enviado" aria-live="polite"></p>
        <div class="explica" hidden>
          <p class="frase">{r.frase}</p>
          <p>{r.explicacion}</p>
        </div>
      </div>
    ))}

    <!-- 5. Fin -->
    <div class="paso centro" data-paso="fin" hidden>
      <h1>¡Terminamos!</h1>
      <div class="tres"><span style="background:var(--bosque)">Pausa</span><span style="background:var(--miel);color:var(--tinta)">Piensa</span><span style="background:var(--arcilla)">Pide ayuda</span></div>
      <p class="nota">Contale a alguien de tu casa el truco de las tres palabras.</p>
    </div>

    <p class="conexion" role="status" aria-live="polite" hidden></p>
    <p class="sin-config" hidden>Las salas con teléfonos todavía no están activadas en esta versión. Jueguen en grupo con el proyector.</p>
  </section>
</Base>

<script>
  import { sb, salasDisponibles, rpc, escucharSala, mensajeError, iconoEquipo, type EstadoSala } from '../../lib/sala';
  import { RONDAS } from '../../content/seguridad';

  const $ = <T extends HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));
  const mostrar = (p: string) => $$<HTMLElement>('.paso').forEach((el) => (el.hidden = el.dataset.paso !== p));
  const conexion = $<HTMLElement>('.conexion');
  const KEY = 'pausa-participante';
  let codigo = '';
  let sala: { room_id: string; name: string; code: string } | null = null;
  let detener: (() => void) | null = null;
  let estado: EstadoSala | null = null;

  if (!salasDisponibles) { $<HTMLElement>('.sin-config').hidden = false; }

  // Teclado
  function pintarCodigo() {
    $$('.casillas span').forEach((s, i) => (s.textContent = codigo[i] ?? ''));
    $<HTMLButtonElement>('[data-entrar]').disabled = codigo.length !== 6;
  }
  $('.teclado').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.n !== undefined && codigo.length < 6) codigo += b.dataset.n;
    if (b.hasAttribute('data-borrar')) codigo = codigo.slice(0, -1);
    if (b.hasAttribute('data-entrar')) entrar();
    pintarCodigo();
  });
  document.addEventListener('keydown', (e) => {
    if ($<HTMLElement>('[data-paso=codigo]').hidden) return;
    if (/^[0-9]$/.test(e.key) && codigo.length < 6) codigo += e.key;
    if (e.key === 'Backspace') codigo = codigo.slice(0, -1);
    if (e.key === 'Enter' && codigo.length === 6) entrar();
    pintarCodigo();
  });

  async function asegurarSesion() {
    const { data } = await sb!.auth.getSession();
    if (!data.session) {
      const { error } = await sb!.auth.signInAnonymously();
      if (error) throw error;
    }
  }

  async function entrar() {
    const err = $<HTMLElement>('[data-paso=codigo] .error');
    err.textContent = '';
    if (!salasDisponibles) { err.textContent = 'Las salas no están activadas. Jueguen en grupo.'; return; }
    try {
      await asegurarSesion();
      const info = await rpc<{ taken: string[]; full: boolean; mine: string | null }>('peek_room', { p_code: codigo });
      if (info.mine) return unirse(info.mine);
      if (info.full) throw new Error('sala_llena');
      $$<HTMLButtonElement>('.eq').forEach((b) => (b.disabled = info.taken.includes(b.dataset.eq!)));
      mostrar('equipo');
    } catch (e) { err.textContent = mensajeError(e); codigo = ''; pintarCodigo(); }
  }

  $('.equipos').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.eq');
    if (b && !b.disabled) unirse(b.dataset.eq!);
  });

  async function unirse(nombre: string) {
    const err = $<HTMLElement>('[data-paso=equipo] .error');
    try {
      const r = await rpc<{ room_id: string; name: string }>('join_room', { p_code: codigo, p_team: nombre });
      sala = { room_id: r.room_id, name: r.name, code: codigo };
      try { sessionStorage.setItem(KEY, JSON.stringify(sala)); } catch {}
      iniciar();
    } catch (e) { err.textContent = mensajeError(e); if (String(e).includes('nombre_tomado')) entrar(); }
  }

  function iniciar() {
    $<HTMLElement>('.mi-equipo').innerHTML = `<span>${iconoEquipo(sala!.name)}</span> Equipo ${sala!.name}`;
    mostrar('espera');
    detener?.();
    detener = escucharSala(sala!.room_id, pintar, () => { conexion.hidden = false; conexion.textContent = 'Reconectando… si no vuelve, sigan jugando en grupo.'; });
  }

  function pintar(s: EstadoSala) {
    conexion.hidden = true;
    estado = s;
    if (s.status === 'lobby') return mostrar('espera');
    if (s.status === 'ended' || s.expired) { detener?.(); try { sessionStorage.removeItem(KEY); } catch {} return mostrar('fin'); }
    const panel = $<HTMLElement>(`[data-paso=q${s.q}]`);
    mostrar(`q${s.q}`);
    const abierta = s.status === 'question';
    panel.querySelectorAll<HTMLButtonElement>('.op').forEach((b) => {
      b.disabled = !abierta;
      b.setAttribute('aria-pressed', String(Number(b.dataset.op) === s.my_answer));
      b.classList.toggle('cuidado', !abierta && RONDAS[s.q].opciones[Number(b.dataset.op)].cuidado);
    });
    $<HTMLElement>('.explica', panel).hidden = abierta;
    $<HTMLElement>('.enviado', panel).textContent = abierta
      ? (s.my_answer === null ? 'Conversen y toquen una opción.' : '¡Listo! Esperen a que se cierre la pregunta. Pueden cambiar mientras esté abierta.')
      : 'Miren la explicación en el proyector.';
  }

  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.op');
    if (!b || !sala || b.disabled) return;
    const q = Number(b.dataset.q), op = Number(b.dataset.op);
    b.closest('.ops')!.querySelectorAll('.op').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const msg = $<HTMLElement>('.enviado', b.closest('.paso')!);
    msg.textContent = 'Enviando…';
    try {
      await rpc('submit_answer', { p_room: sala.room_id, p_q: q, p_option: op });
      msg.textContent = '¡Listo! Esperen a que se cierre la pregunta. Pueden cambiar mientras esté abierta.';
    } catch (err) { msg.textContent = mensajeError(err); }
  });

  // Reconexión: si el teléfono ya estaba en una sala, vuelve a ella.
  try {
    const g = sessionStorage.getItem(KEY);
    if (g && salasDisponibles) { sala = JSON.parse(g); codigo = sala!.code; iniciar(); }
  } catch {}
</script>

<style>
  .movil { max-width: 520px; padding-top: 1.4rem; }
  .paso { display: grid; gap: 1rem; }
  .paso[hidden] { display: none; }
  .centro { text-align: center; justify-items: center; padding-top: 2rem; }
  h1 { font-size: 1.8rem; text-align: center; }
  .casillas { display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; }
  .casillas span { height: 64px; border: 3px solid var(--tinta); border-radius: 14px; background: #fff; display: grid; place-items: center; font: 800 2rem/1 var(--f-control); }
  .teclado { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; }
  .teclado button { min-height: 72px; font: 800 1.8rem/1 var(--f-control); border: 3px solid var(--tinta); border-radius: 18px; background: var(--pagina); box-shadow: 0 4px 0 var(--tinta); color: var(--tinta); cursor: pointer; }
  .teclado button:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--tinta); }
  .teclado .entrar { background: var(--bosque); color: #fff; font-size: 1.3rem; }
  .teclado .entrar:disabled { opacity: .4; }
  .error { color: var(--arcilla); font: 800 1.1rem/1.3 var(--f-control); text-align: center; min-height: 1.3em; margin: 0; }
  .pista { text-align: center; color: var(--tinta-suave); font-size: .95rem; }
  .equipos { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .eq { min-height: 84px; border: 3px solid var(--tinta); border-radius: 18px; background: #fff; box-shadow: 0 4px 0 var(--c); font: 800 1.2rem/1 var(--f-control); color: var(--tinta); display: flex; align-items: center; justify-content: center; gap: .5rem; cursor: pointer; }
  .eq span { font-size: 1.8rem; }
  .eq:disabled { opacity: .3; cursor: not-allowed; text-decoration: line-through; }
  .mi-equipo { font: 800 1.4rem/1 var(--f-control); background: var(--miel-claro); padding: .8rem 1.2rem; border-radius: 999px; }
  .mi-equipo :global(span) { font-size: 1.8rem; }
  .kicker { font: 800 .85rem/1 var(--f-control); letter-spacing: .06em; text-transform: uppercase; color: var(--bosque); margin: 0; }
  .burbuja-m { background: #fff; border: 3px solid var(--tinta); border-radius: 18px 18px 18px 4px; padding: .9rem 1rem; font: 700 1.2rem/1.35 var(--f-control); margin: 0; }
  .ops { display: grid; gap: .9rem; }
  .op { position: relative; display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: .8rem; text-align: left; min-height: 110px; padding: .6rem .9rem .6rem .6rem; border: 3px solid var(--tinta); border-radius: 20px; background: #fff; box-shadow: 0 4px 0 var(--tinta); font: 800 1.15rem/1.25 var(--f-control); color: var(--tinta); cursor: pointer; }
  .op .n { position: absolute; top: -12px; left: -10px; width: 38px; height: 38px; border-radius: 50%; background: var(--miel); border: 3px solid var(--tinta); display: grid; place-items: center; font: 800 1.2rem/1 var(--f-control); }
  .op[aria-pressed="true"] { background: var(--miel-claro); outline: 4px solid var(--miel); }
  .op:disabled { cursor: default; opacity: .6; }
  .op.cuidado { background: var(--bosque-claro); border-color: var(--bosque); opacity: 1; }
  .enviado { text-align: center; font: 700 1.05rem/1.3 var(--f-control); color: var(--bosque); margin: 0; }
  .explica { background: var(--bosque-claro); border-left: 6px solid var(--bosque); border-radius: 12px; padding: .8rem 1rem; }
  .explica .frase { font: 400 1.4rem/1.2 var(--f-cuento); color: var(--bosque); margin-bottom: .3rem; }
  .tres { display: flex; gap: .5rem; width: 100%; }
  .tres span { flex: 1; border-radius: 14px; padding: 1rem .3rem; color: #fff; font: 400 1.2rem/1 var(--f-cuento); }
  .conexion, .sin-config { margin-top: 1rem; text-align: center; background: var(--miel-claro); border-radius: 12px; padding: .7rem; font: 700 1rem/1.3 var(--f-control); }
</style>
